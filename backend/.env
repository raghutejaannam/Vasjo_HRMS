NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:123456@localhost:5000/vasjo_db?schema=public"

JWT_SECRET=vasjo-development-secret-change-before-production
JWT_REFRESH_SECRET=vasjo-refresh-secret-change-before-production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

DEFAULT_ADMIN_EMAIL=admin@vasjo.in
DEFAULT_ADMIN_PASSWORD=Admin@123

REDIS_URL=redis://localhost:6379