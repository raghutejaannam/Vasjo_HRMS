// prisma/schema.prisma
//
// PostgreSQL schema for the Vasjo Technologies Timesheet/Leave/Payroll backend.
// This is a direct, field-for-field translation of the original SQLite schema
// (src/db.js in the source project) — no tables were removed, renamed, or
// restructured. See migration.sql in prisma/migrations/0001_init for the
// exact DDL (including CHECK constraints, which Prisma's schema language
// does not have a first-class attribute for).
//
// Design decisions made to guarantee byte-for-byte API compatibility with the
// existing frontend during this database-engine change (documented in the
// migration report / README):
//   - Boolean-style flag columns (active, is_active, read, escalated, etc.)
//     stay as Int (0/1), matching the original SQLite representation. The
//     frontend already expects 0/1, not true/false.
//   - Date/timestamp columns stay as String (TEXT), holding the same
//     'YYYY-MM-DD' / 'YYYY-MM-DD HH:MM:SS' formatted text the app already
//     generates and returns to the frontend. Using native Postgres
//     timestamp types would change how node-postgres/Prisma serializes
//     these values in JSON responses (ISO-8601 with a T/Z) and silently
//     break the API contract.
//   - IDs that were TEXT primary keys generated by the application
//     (timesheets.id = "TS-1001", leave_applications.id = "LV-201") stay as
//     String @id — they are not database-generated.
//
// Most read/write access in src/db.js uses Prisma's parameterized
// $queryRaw/$executeRaw/$transaction (via the dbGet/dbAll/dbRun/withTx
// helpers) rather than the Prisma Client query-builder API, specifically to
// preserve the original SQL semantics exactly during the engine swap. This
// schema remains the source of truth for `prisma migrate` / `prisma generate`
// and is safe to use with the query-builder API incrementally later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// CORE / AUTH
// ---------------------------------------------------------------------------

model User {
  id                     Int      @id @default(autoincrement())
  name                   String
  email                  String   @unique
  passwordHash           String   @map("password_hash")
  passwordSalt           String   @map("password_salt")
  role                   String // 'employee' | 'manager' | 'admin'
  title                  String?
  dept                   String?
  managerId              Int?     @map("manager_id")
  delegateId             Int?     @map("delegate_id")
  phone                  String?
  joinedDate             String?  @map("joined_date")
  mustResetPassword      Int      @default(0) @map("must_reset_password")
  active                 Int      @default(1)
  avatarColor            String   @default("#C08A2E") @map("avatar_color")
  emergencyContactName   String?  @map("emergency_contact_name")
  emergencyContactPhone  String?  @map("emergency_contact_phone")
  employeeCode           String?  @map("employee_code")
  location               String?
  gender                 String?
  uan                    String?
  pfNumber               String?  @map("pf_number")
  pan                    String?
  esiNumber              String?  @map("esi_number")
  bankAccountNo          String?  @map("bank_account_no")
  bankName               String?  @map("bank_name")
  employeeGroup          String?  @map("employee_group")
  lifecycleStatus        String   @default("active") @map("lifecycle_status") // onboarding | probation | confirmed | active | notice_period | exited
  createdAt              String   @default("") @map("created_at")

  @@map("users")
}

model Session {
  token     String   @id
  csrfToken String   @map("csrf_token")
  userId    Int      @map("user_id")
  createdAt String   @default("") @map("created_at")
  expiresAt String   @map("expires_at")

  @@map("sessions")
}

model LeaveType {
  id                   Int    @id @default(autoincrement())
  name                 String @unique
  defaultAnnualDays    Float  @default(0) @map("default_annual_days")
  maxCarryForwardDays  Float  @default(0) @map("max_carry_forward_days")
  active               Int    @default(1)

  @@map("leave_types")
}

model LeaveBalance {
  id                   Int     @id @default(autoincrement())
  userId               Int     @map("user_id")
  leaveTypeId          Int     @map("leave_type_id")
  year                 Int
  totalDays            Float   @default(0) @map("total_days")
  usedDays             Float   @default(0) @map("used_days")
  carriedForwardDays   Float   @default(0) @map("carried_forward_days")
  carryForwardExpiresOn String? @map("carry_forward_expires_on")

  @@unique([userId, leaveTypeId, year])
  @@map("leave_balances")
}

model Timesheet {
  id                     String   @id
  userId                 Int      @map("user_id")
  weekStart              String   @map("week_start")
  status                 String   @default("draft")
  totalHours             Float    @default(0) @map("total_hours")
  overtimeHours          Float    @default(0) @map("overtime_hours")
  submittedAt            String?  @map("submitted_at")
  decidedAt              String?  @map("decided_at")
  decidedBy              Int?     @map("decided_by")
  lastComment            String?  @map("last_comment")
  correctionStatus       String?  @map("correction_status")
  correctionReason       String?  @map("correction_reason")
  correctionRequestedAt  String?  @map("correction_requested_at")
  escalated              Int      @default(0)
  createdAt              String   @default("") @map("created_at")

  @@unique([userId, weekStart])
  @@map("timesheets")
}

model Project {
  id        Int     @id @default(autoincrement())
  name      String
  code      String?
  active    Int     @default(1)
  createdAt String  @default("") @map("created_at")

  @@map("projects")
}

model Task {
  id         Int     @id @default(autoincrement())
  projectId  Int     @map("project_id")
  name       String
  active     Int     @default(1)

  @@map("tasks")
}

model EmployeeProject {
  id         Int  @id @default(autoincrement())
  userId     Int  @map("user_id")
  projectId  Int  @map("project_id")

  @@unique([userId, projectId])
  @@map("employee_projects")
}

model Department {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  active  Int     @default(1)

  @@map("departments")
}

model TimesheetEntry {
  id            Int     @id @default(autoincrement())
  timesheetId   String  @map("timesheet_id")
  entryDate     String  @map("entry_date")
  hours         Float   @default(0)
  note          String?
  projectId     Int?    @map("project_id")
  taskId        Int?    @map("task_id")
  workMode      String? @map("work_mode")
  inTime        String? @map("in_time")
  outTime       String? @map("out_time")

  @@map("timesheet_entries")
}

model LeaveApplication {
  id                     String  @id
  userId                 Int     @map("user_id")
  leaveTypeId            Int     @map("leave_type_id")
  fromDate               String  @map("from_date")
  toDate                 String  @map("to_date")
  days                   Float
  unit                   String  @default("day") @map("unit") // 'day' | 'hour'
  reason                 String?
  status                 String  @default("pending")
  appliedAt              String  @default("") @map("applied_at")
  decidedAt              String? @map("decided_at")
  decidedBy              Int?    @map("decided_by")
  lastComment            String? @map("last_comment")
  escalated              Int     @default(0)
  isSandwich             Int     @default(0) @map("is_sandwich")
  compOffId              Int?    @map("comp_off_id")
  currentApprovalLevel   Int     @default(1) @map("current_approval_level")
  requiredApprovalLevels Int     @default(1) @map("required_approval_levels")

  @@map("leave_applications")
}

model ApprovalsLog {
  id         Int     @id @default(autoincrement())
  entityType String  @map("entity_type")
  entityId   String  @map("entity_id")
  action     String
  actorId    Int     @map("actor_id")
  actedAt    String  @default("") @map("acted_at")
  notes      String?

  @@map("approvals_log")
}

model CompanyHoliday {
  id           Int     @id @default(autoincrement())
  holidayDate  String  @unique @map("holiday_date")
  name         String
  blackout     Int     @default(0)

  @@map("company_holidays")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

model Notification {
  id          Int     @id @default(autoincrement())
  userId      Int     @map("user_id")
  type        String
  message     String
  entityType  String? @map("entity_type")
  entityId    String? @map("entity_id")
  read        Int     @default(0)
  createdAt   String  @default("") @map("created_at")

  @@map("notifications")
}

// ---------------------------------------------------------------------------
// PAYROLL MODULE
// ---------------------------------------------------------------------------

model FinancialYear {
  id         Int     @id @default(autoincrement())
  name       String  @unique
  startDate  String  @map("start_date")
  endDate    String  @map("end_date")
  isActive   Int     @default(0) @map("is_active")
  createdAt  String  @default("") @map("created_at")

  @@map("financial_years")
}

model SalaryComponent {
  id                Int     @id @default(autoincrement())
  code              String  @unique
  name              String
  type              String
  category          String?
  isTaxable         Int     @default(1) @map("is_taxable")
  isFixed           Int     @default(1) @map("is_fixed")
  calculationType   String? @map("calculation_type")
  calculationValue  Float?  @map("calculation_value")
  formula           String?
  conditionalRule   String? @map("conditional_rule")
  displayOrder      Int     @default(0) @map("display_order")
  isActive          Int     @default(1) @map("is_active")
  createdAt         String  @default("") @map("created_at")
  updatedAt         String  @default("") @map("updated_at")

  @@map("salary_components")
}

model EmployeeSalaryStructure {
  id                     Int     @id @default(autoincrement())
  userId                 Int     @map("user_id")
  financialYearId        Int     @map("financial_year_id")
  effectiveFrom          String  @map("effective_from")
  effectiveTo            String? @map("effective_to")
  annualCtc              Float   @map("annual_ctc")
  monthlyCtc             Float   @map("monthly_ctc")
  basicSalary            Float   @map("basic_salary")
  offerLetterPath        String? @map("offer_letter_path")
  offerLetterUploadedAt  String? @map("offer_letter_uploaded_at")
  status                 String  @default("draft")
  createdBy              Int     @map("created_by")
  createdAt              String  @default("") @map("created_at")
  updatedAt              String  @default("") @map("updated_at")

  @@unique([userId, financialYearId, effectiveFrom])
  @@map("employee_salary_structures")
}

model SalaryStructureComponent {
  id                  Int     @id @default(autoincrement())
  salaryStructureId   Int     @map("salary_structure_id")
  componentId         Int     @map("component_id")
  amount              Float   @default(0)
  isOverride          Int     @default(0) @map("is_override")
  createdAt           String  @default("") @map("created_at")

  @@unique([salaryStructureId, componentId])
  @@map("salary_structure_components")
}

model TaxRegime {
  id               Int     @id @default(autoincrement())
  financialYearId  Int     @map("financial_year_id")
  code             String
  name             String
  isDefault        Int     @default(0) @map("is_default")
  isActive         Int     @default(1) @map("is_active")

  @@unique([financialYearId, code])
  @@map("tax_regimes")
}

model TaxSlab {
  id            Int     @id @default(autoincrement())
  taxRegimeId   Int     @map("tax_regime_id")
  minIncome     Float   @map("min_income")
  maxIncome     Float?  @map("max_income")
  rate          Float
  displayOrder  Int     @default(0) @map("display_order")

  @@map("tax_slabs")
}

model TaxRule {
  id            Int     @id @default(autoincrement())
  taxRegimeId   Int     @map("tax_regime_id")
  ruleKey       String  @map("rule_key")
  ruleValue     Float   @map("rule_value")
  ruleType      String  @map("rule_type")
  description   String?

  @@unique([taxRegimeId, ruleKey])
  @@map("tax_rules")
}

model DeductionLimit {
  id                Int     @id @default(autoincrement())
  financialYearId   Int     @map("financial_year_id")
  sectionCode       String  @map("section_code")
  sectionName       String  @map("section_name")
  limitAmount       Float   @map("limit_amount")
  isActive          Int     @default(1) @map("is_active")

  @@unique([financialYearId, sectionCode])
  @@map("deduction_limits")
}

model EmployeeTaxRegime {
  id               Int     @id @default(autoincrement())
  userId           Int     @map("user_id")
  financialYearId  Int     @map("financial_year_id")
  taxRegimeId      Int     @map("tax_regime_id")
  selectedAt       String  @default("") @map("selected_at")
  selectedBy       Int     @map("selected_by")

  @@unique([userId, financialYearId])
  @@map("employee_tax_regime")
}

model TaxDeclarationSection {
  id                Int     @id @default(autoincrement())
  financialYearId   Int     @map("financial_year_id")
  sectionCode       String  @map("section_code")
  sectionName       String  @map("section_name")
  description       String?
  maxLimit          Float?  @map("max_limit")
  isActive          Int     @default(1) @map("is_active")
  displayOrder      Int     @default(0) @map("display_order")
  applicableRegime  String  @default("old") @map("applicable_regime")

  @@unique([financialYearId, sectionCode])
  @@map("tax_declaration_sections")
}

model TaxDeclaration {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  financialYearId   Int     @map("financial_year_id")
  sectionId         Int     @map("section_id")
  declaredAmount    Float   @default(0) @map("declared_amount")
  eligibleAmount    Float   @default(0) @map("eligible_amount")
  status            String  @default("draft")
  submittedAt       String? @map("submitted_at")
  verifiedBy        Int?    @map("verified_by")
  verifiedAt        String? @map("verified_at")
  rejectionReason   String? @map("rejection_reason")
  createdAt         String  @default("") @map("created_at")
  updatedAt         String  @default("") @map("updated_at")

  @@map("tax_declarations")
}

model TaxDeclarationEntry {
  id                  Int     @id @default(autoincrement())
  taxDeclarationId    Int     @map("tax_declaration_id")
  investmentType      String? @map("investment_type")
  providerName        String? @map("provider_name")
  amount              Float
  investmentDate      String? @map("investment_date")
  financialYear       String? @map("financial_year")
  supportingDocPath   String? @map("supporting_doc_path")
  status              String  @default("declared")
  approvedAmount      Float?  @map("approved_amount")
  approvedBy          Int?    @map("approved_by")
  approvedAt          String? @map("approved_at")
  rejectionReason     String? @map("rejection_reason")
  createdAt           String  @default("") @map("created_at")
  updatedAt           String  @default("") @map("updated_at")

  @@map("tax_declaration_entries")
}

model FixedDeduction {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  financialYearId   Int     @map("financial_year_id")
  componentId       Int     @map("component_id")
  amount            Float
  effectiveFrom     String  @map("effective_from")
  effectiveTo       String? @map("effective_to")
  isActive          Int     @default(1) @map("is_active")
  createdAt         String  @default("") @map("created_at")

  @@map("fixed_deductions")
}

model VariableDeduction {
  id            Int     @id @default(autoincrement())
  userId        Int     @map("user_id")
  payrollMonth  String  @map("payroll_month")
  componentId   Int     @map("component_id")
  amount        Float
  reason        String?
  createdBy     Int     @map("created_by")
  createdAt     String  @default("") @map("created_at")

  @@unique([userId, payrollMonth, componentId])
  @@map("variable_deductions")
}

model PreviousEmployerIncome {
  id                        Int     @id @default(autoincrement())
  userId                    Int     @map("user_id")
  financialYearId           Int     @map("financial_year_id")
  previousEmployerName      String? @map("previous_employer_name")
  grossIncome               Float   @default(0) @map("gross_income")
  tdsDeducted               Float   @default(0) @map("tds_deducted")
  professionalTaxPaid       Float   @default(0) @map("professional_tax_paid")
  joiningDateCurrentOrg     String? @map("joining_date_current_org")
  documentPath              String? @map("document_path")
  createdAt                 String  @default("") @map("created_at")

  @@unique([userId, financialYearId])
  @@map("previous_employer_income")
}

model PayrollRun {
  id                Int     @id @default(autoincrement())
  financialYearId   Int     @map("financial_year_id")
  payrollMonth      String  @map("payroll_month")
  status            String  @default("draft")
  totalEmployees    Int     @default(0) @map("total_employees")
  totalGross        Float   @default(0) @map("total_gross")
  totalDeductions   Float   @default(0) @map("total_deductions")
  totalTds          Float   @default(0) @map("total_tds")
  totalNet          Float   @default(0) @map("total_net")
  calculatedBy      Int?    @map("calculated_by")
  calculatedAt      String? @map("calculated_at")
  reviewedBy        Int?    @map("reviewed_by")
  reviewedAt        String? @map("reviewed_at")
  approvedBy        Int?    @map("approved_by")
  approvedAt        String? @map("approved_at")
  lockedBy          Int?    @map("locked_by")
  lockedAt          String? @map("locked_at")
  createdAt         String  @default("") @map("created_at")

  @@unique([financialYearId, payrollMonth])
  @@map("payroll_runs")
}

model PayrollDetail {
  id                        Int     @id @default(autoincrement())
  payrollRunId              Int     @map("payroll_run_id")
  userId                    Int     @map("user_id")
  salaryStructureId         Int?    @map("salary_structure_id")
  basicEarning              Float   @default(0) @map("basic_earning")
  hraEarning                Float   @default(0) @map("hra_earning")
  allowancesEarning         Float   @default(0) @map("allowances_earning")
  variableEarning           Float   @default(0) @map("variable_earning")
  overtimeEarning           Float   @default(0) @map("overtime_earning")
  bonusEarning               Float   @default(0) @map("bonus_earning")
  reimbursementEarning      Float   @default(0) @map("reimbursement_earning")
  otherEarning              Float   @default(0) @map("other_earning")
  grossEarning              Float   @default(0) @map("gross_earning")
  pfEmployeeDeduction       Float   @default(0) @map("pf_employee_deduction")
  professionalTaxDeduction  Float   @default(0) @map("professional_tax_deduction")
  insuranceDeduction        Float   @default(0) @map("insurance_deduction")
  otherFixedDeduction       Float   @default(0) @map("other_fixed_deduction")
  variableDeductionsTotal   Float   @default(0) @map("variable_deductions_total")
  tdsDeduction              Float   @default(0) @map("tds_deduction")
  totalDeductions           Float   @default(0) @map("total_deductions")
  taxableIncome             Float   @default(0) @map("taxable_income")
  annualTaxableIncome       Float   @default(0) @map("annual_taxable_income")
  annualTax                 Float   @default(0) @map("annual_tax")
  monthlyTds                Float   @default(0) @map("monthly_tds")
  tdsAlreadyDeducted        Float   @default(0) @map("tds_already_deducted")
  remainingTaxLiability     Float   @default(0) @map("remaining_tax_liability")
  loanDeduction              Float   @default(0) @map("loan_deduction")
  advanceRecoveryDeduction   Float   @default(0) @map("advance_recovery_deduction")
  arrearsEarning             Float   @default(0) @map("arrears_earning")
  leaveEncashmentEarning     Float   @default(0) @map("leave_encashment_earning")
  netSalary                 Float   @default(0) @map("net_salary")
  workingDays               Int     @default(0) @map("working_days")
  paidDays                  Int     @default(0) @map("paid_days")
  lopDays                   Int     @default(0) @map("lop_days")
  status                    String  @default("calculated")
  exceptionFlags            String? @map("exception_flags")
  reviewedBy                Int?    @map("reviewed_by")
  reviewedAt                String? @map("reviewed_at")
  approvedBy                Int?    @map("approved_by")
  approvedAt                String? @map("approved_at")
  createdAt                 String  @default("") @map("created_at")
  updatedAt                 String  @default("") @map("updated_at")

  @@unique([payrollRunId, userId])
  @@map("payroll_details")
}

model Payslip {
  id                  Int     @id @default(autoincrement())
  payrollDetailId     Int     @unique @map("payroll_detail_id")
  userId              Int     @map("user_id")
  payrollMonth        String  @map("payroll_month")
  pdfPath             String? @map("pdf_path")
  generatedAt         String  @default("") @map("generated_at")
  generatedBy         Int     @map("generated_by")
  downloadedAt        String? @map("downloaded_at")
  downloadedBy        Int?    @map("downloaded_by")

  @@map("payslips")
}

model PayrollException {
  id                Int     @id @default(autoincrement())
  payrollRunId      Int     @map("payroll_run_id")
  userId            Int     @map("user_id")
  exceptionCode     String  @map("exception_code")
  exceptionMessage  String  @map("exception_message")
  severity          String
  isResolved        Int     @default(0) @map("is_resolved")
  resolvedBy        Int?    @map("resolved_by")
  resolvedAt        String? @map("resolved_at")
  resolutionNotes   String? @map("resolution_notes")
  createdAt         String  @default("") @map("created_at")

  @@map("payroll_exceptions")
}

model PayrollAuditLog {
  id          Int     @id @default(autoincrement())
  entityType  String  @map("entity_type")
  entityId    String  @map("entity_id")
  action      String
  actorId     Int     @map("actor_id")
  oldValues   String? @map("old_values")
  newValues   String? @map("new_values")
  actedAt     String  @default("") @map("acted_at")

  @@map("payroll_audit_log")
}

model PayrollAdjustment {
  id                Int     @id @default(autoincrement())
  payrollDetailId   Int     @map("payroll_detail_id")
  adjustmentType    String  @map("adjustment_type")
  componentId       Int?    @map("component_id")
  amount            Float
  reason            String
  requestedBy       Int     @map("requested_by")
  approvedBy        Int?    @map("approved_by")
  approvedAt        String? @map("approved_at")
  status            String  @default("pending")
  createdAt         String  @default("") @map("created_at")

  @@map("payroll_adjustments")
}

model SalaryRevision {
  id                    Int     @id @default(autoincrement())
  userId                Int     @map("user_id")
  salaryStructureId     Int?    @map("salary_structure_id")
  previousAnnualCtc     Float?  @map("previous_annual_ctc")
  newAnnualCtc          Float   @map("new_annual_ctc")
  previousMonthlyCtc    Float?  @map("previous_monthly_ctc")
  newMonthlyCtc         Float   @map("new_monthly_ctc")
  previousBasicSalary   Float?  @map("previous_basic_salary")
  newBasicSalary        Float?  @map("new_basic_salary")
  hikePercentage        Float?  @map("hike_percentage")
  hikeAmount            Float?  @map("hike_amount")
  effectiveDate         String  @map("effective_date")
  revisionType          String  @map("revision_type")
  reason                String?
  notes                 String?
  isRetroactive         Int     @default(0) @map("is_retroactive")
  approvedBy            Int     @map("approved_by")
  createdAt             String  @default("") @map("created_at")
  updatedAt             String  @default("") @map("updated_at")

  @@index([userId])
  @@index([effectiveDate])
  @@map("salary_revisions")
}

// ---------------------------------------------------------------------------
// PAYROLL BLOCK 4 EXTENSIONS — loans, salary advances, leave encashment,
// arrears. All four feed into calculateMonthlyPayroll (src/payroll.js) as
// either a deduction (loans, advances) or a one-time earning (arrears, leave
// encashment) once approved, and are settled/marked paid against the
// resulting payroll_details row in the same transaction as the payroll run.
// ---------------------------------------------------------------------------

model Loan {
  id                 Int     @id @default(autoincrement())
  userId             Int     @map("user_id")
  principalAmount    Float   @map("principal_amount")
  interestRateAnnual Float   @default(0) @map("interest_rate_annual")
  tenureMonths       Int     @map("tenure_months")
  emiAmount          Float   @default(0) @map("emi_amount")
  outstandingBalance Float   @default(0) @map("outstanding_balance")
  purpose            String?
  status             String  @default("pending") // pending | approved | rejected | active | closed | cancelled
  requestedAt        String  @default("") @map("requested_at")
  approvedBy         Int?    @map("approved_by")
  approvedAt         String? @map("approved_at")
  disbursedAt        String? @map("disbursed_at")
  closedAt           String? @map("closed_at")
  createdAt          String  @default("") @map("created_at")

  @@index([userId])
  @@map("loans")
}

model LoanRepayment {
