}

model SalaryAdvance {
  id                    Int     @id @default(autoincrement())
  userId                Int     @map("user_id")
  amount                Float
  reason                String?
  status                String  @default("pending") // pending | approved | rejected | recovering | closed
  requestedAt           String  @default("") @map("requested_at")
  approvedBy            Int?    @map("approved_by")
  approvedAt            String? @map("approved_at")
  recoveryMonths        Int     @default(1) @map("recovery_months")
  monthlyRecoveryAmount Float   @default(0) @map("monthly_recovery_amount")
  outstandingBalance    Float   @default(0) @map("outstanding_balance")
  createdAt             String  @default("") @map("created_at")

  @@index([userId])
  @@map("salary_advances")
}

model AdvanceRecovery {
  id              Int     @id @default(autoincrement())
  advanceId       Int     @map("advance_id")
  payrollDetailId Int?    @map("payroll_detail_id")
  payrollMonth    String  @map("payroll_month")
  amount          Float
  balanceAfter    Float   @default(0) @map("balance_after")
  createdAt       String  @default("") @map("created_at")

  @@index([advanceId])
  @@map("advance_recoveries")
}

model LeaveEncashment {
  id              Int     @id @default(autoincrement())
  userId          Int     @map("user_id")
  leaveTypeId     Int     @map("leave_type_id")
  financialYearId Int     @map("financial_year_id")
  days            Float
  perDayAmount    Float   @default(0) @map("per_day_amount")
  amount          Float   @default(0)
  status          String  @default("pending") // pending | approved | rejected | paid
  requestedAt     String  @default("") @map("requested_at")
  approvedBy      Int?    @map("approved_by")
  approvedAt      String? @map("approved_at")
  payrollDetailId Int?    @map("payroll_detail_id")
  createdAt       String  @default("") @map("created_at")

  @@index([userId])
  @@map("leave_encashments")
}

model ArrearsPayment {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  salaryRevisionId  Int?    @map("salary_revision_id")
  forPayrollMonth   String  @map("for_payroll_month")
  amount            Float
  reason            String?
  status            String  @default("pending") // pending | paid
  payrollDetailId   Int?    @map("payroll_detail_id")
  createdAt         String  @default("") @map("created_at")

  @@index([userId])
  @@map("arrears_payments")
}

