model Shift {
  id                     Int     @id @default(autoincrement())
  code                   String  @unique
  name                   String
  startTime              String  @map("start_time") // "HH:MM", 24h
  endTime                String  @map("end_time")
  gracePeriodMinutes     Int     @default(10) @map("grace_period_minutes")
  breakMinutes           Int     @default(60) @map("break_minutes")
  fullDayMinMinutes      Int     @default(480) @map("full_day_min_minutes")
  halfDayMinMinutes      Int     @default(240) @map("half_day_min_minutes")
  isNightShift           Int     @default(0) @map("is_night_shift")
  active                 Int     @default(1)
  createdAt              String  @default("") @map("created_at")

  @@map("shifts")
}

model ShiftAssignment {
  id            Int     @id @default(autoincrement())
  userId        Int     @map("user_id")
  shiftId       Int     @map("shift_id")
  effectiveFrom String  @map("effective_from")
  effectiveTo   String? @map("effective_to")
  createdBy     Int     @map("created_by")
  createdAt     String  @default("") @map("created_at")

  @@index([userId])
  @@map("shift_assignments")
}

model AttendanceRecord {
  id              Int     @id @default(autoincrement())
  userId          Int     @map("user_id")
  date            String
  shiftId         Int?    @map("shift_id")
  checkInAt       String? @map("check_in_at")
  checkOutAt      String? @map("check_out_at")
  status          String  @default("pending") // present | absent | half_day | wfh | on_duty | holiday | weekly_off | leave | pending
  workedMinutes   Float   @default(0) @map("worked_minutes")
  lateMinutes     Int     @default(0) @map("late_minutes")
  earlyLeaveMinutes Int   @default(0) @map("early_leave_minutes")
  source          String  @default("check_in_out") // check_in_out | manual | regularization
  notes           String?
  markedBy        Int?    @map("marked_by")
  createdAt       String  @default("") @map("created_at")
  updatedAt       String  @default("") @map("updated_at")

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("attendance_records")
}

model AttendanceCorrectionRequest {
  id                   Int     @id @default(autoincrement())
  userId               Int     @map("user_id")
  date                 String
  attendanceRecordId   Int?    @map("attendance_record_id")
  requestedCheckInAt   String? @map("requested_check_in_at")
  requestedCheckOutAt  String? @map("requested_check_out_at")
  requestedStatus      String? @map("requested_status")
  reason               String?
  status               String  @default("pending") // pending | approved | rejected
  decidedBy            Int?    @map("decided_by")
  decidedAt            String? @map("decided_at")
  createdAt            String  @default("") @map("created_at")

  @@index([userId])
  @@map("attendance_correction_requests")
}

