// ---------------------------------------------------------------------------
// BLOCK 3 — ADVANCED LEAVE MANAGEMENT
// ---------------------------------------------------------------------------

// Resolution order when computing an employee's effective policy for a leave
// type: employee-specific row > department-specific row > leave type's own
// defaults (no policy row at all). userId and departmentId are mutually
// exclusive; both null means this policy doesn't apply (shouldn't happen in
// practice — leave.js only ever creates scoped rows).
model LeavePolicy {
  id                        Int     @id @default(autoincrement())
  leaveTypeId               Int     @map("leave_type_id")
  departmentName             String? @map("department_name")
  userId                    Int?    @map("user_id")
  annualDays                Float   @map("annual_days")
  accrualMethod             String  @default("annual") @map("accrual_method") // annual | monthly
  monthlyAccrualDays        Float?  @map("monthly_accrual_days")
  carryForwardEnabled       Int     @default(0) @map("carry_forward_enabled")
  maxCarryForwardDays       Float   @default(0) @map("max_carry_forward_days")
  carryForwardExpiryMonths  Int     @default(3) @map("carry_forward_expiry_months")
  minServiceDaysBeforeEligible Int  @default(0) @map("min_service_days_before_eligible")
  allowNegativeBalance      Int     @default(0) @map("allow_negative_balance")
  maxNegativeDays           Float   @default(0) @map("max_negative_days")
  isSandwichLeave           Int     @default(0) @map("is_sandwich_leave")
  unit                      String  @default("day") @map("unit") // day | hour
  createdAt                 String  @default("") @map("created_at")
  updatedAt                 String  @default("") @map("updated_at")

  @@index([leaveTypeId])
  @@map("leave_policies")
}

model CompOff {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  workedDate        String  @map("worked_date")
  earnedDays        Float   @default(1) @map("earned_days")
  reason            String?
  status            String  @default("pending") // pending | approved | rejected | used | expired
  approvedBy        Int?    @map("approved_by")
  approvedAt        String? @map("approved_at")
  expiresOn         String? @map("expires_on")
  usedInApplicationId String? @map("used_in_application_id")
  createdAt         String  @default("") @map("created_at")

  @@index([userId])
  @@map("comp_offs")
}

// Per-level decision log for multi-level leave approval — leave_applications
// keeps an overall status plus current_approval_level/required_approval_levels;
// this table is the audit trail of who decided what at which level.
model LeaveApproval {
  id                 Int     @id @default(autoincrement())
  leaveApplicationId String  @map("leave_application_id")
  level              Int
  approverId         Int     @map("approver_id")
  decision           String // approved | rejected
  comment            String?
  decidedAt          String  @default("") @map("decided_at")

  @@index([leaveApplicationId])
  @@map("leave_approvals")
}

// ---------------------------------------------------------------------------
// BLOCK 1 — ADVANCED EMPLOYEE LIFECYCLE
// ---------------------------------------------------------------------------

// Single append-only timeline covering employment history, department
// transfers, designation/manager/location changes, promotions, probation
// milestones, and status changes — one table instead of five near-identical
// ones. Transfer/promotion functions in lifecycle.js update the live field
// on `users` AND insert one of these for history, in the same transaction.
model EmployeeLifecycleEvent {
  id            Int     @id @default(autoincrement())
  userId        Int     @map("user_id")
  eventType     String  @map("event_type") // joined | department_transfer | designation_change | manager_change | location_change | promotion | probation_started | probation_confirmed | probation_extended | status_change | resigned | exited
  previousValue String? @map("previous_value")
  newValue      String? @map("new_value")
  effectiveDate String  @map("effective_date")
  notes         String?
  recordedBy    Int     @map("recorded_by")
  createdAt     String  @default("") @map("created_at")

  @@index([userId])
  @@map("employee_lifecycle_events")
}

model ProbationRecord {
  id                     Int     @id @default(autoincrement())
  userId                 Int     @map("user_id")
  startDate              String  @map("start_date")
  expectedEndDate        String  @map("expected_end_date")
  actualConfirmationDate String? @map("actual_confirmation_date")
  status                 String  @default("on_probation") // on_probation | confirmed | extended
  extendedToDate         String? @map("extended_to_date")
  notes                  String?
  confirmedBy            Int?    @map("confirmed_by")
  createdAt              String  @default("") @map("created_at")
  updatedAt              String  @default("") @map("updated_at")

  @@index([userId])
  @@map("probation_records")
}

model EmployeeDocument {
  id          Int     @id @default(autoincrement())
  userId      Int     @map("user_id")
  docType     String  @map("doc_type")
  filePath    String? @map("file_path")
  issueDate   String? @map("issue_date")
  expiryDate  String? @map("expiry_date")
  uploadedBy  Int     @map("uploaded_by")
  uploadedAt  String  @default("") @map("uploaded_at")

  @@index([userId])
  @@map("employee_documents")
}

model ChecklistTemplateItem {
  id           Int     @id @default(autoincrement())
  type         String  // onboarding | offboarding
  label        String
  description  String?
  displayOrder Int     @default(0) @map("display_order")
  active       Int     @default(1)

  @@map("checklist_template_items")
}

model EmployeeChecklistTask {
  id                   Int     @id @default(autoincrement())
  userId               Int     @map("user_id")
  employeeSeparationId Int?    @map("employee_separation_id") // set only for offboarding tasks
  templateItemId       Int?    @map("template_item_id")
  type                 String  // onboarding | offboarding
  label                String  // snapshot of the template label at creation time
  status               String  @default("pending") // pending | completed | skipped
  completedBy          Int?    @map("completed_by")
  completedAt          String? @map("completed_at")
  notes                String?
  createdAt            String  @default("") @map("created_at")

  @@index([userId])
  @@map("employee_checklist_tasks")
}

model ExitInterview {
  id                   Int     @id @default(autoincrement())
  employeeSeparationId Int     @unique @map("employee_separation_id")
  conductedBy          Int     @map("conducted_by")
  conductedAt          String  @default("") @map("conducted_at")
  reasonForLeaving     String? @map("reason_for_leaving")
  feedback             String?
  wouldRehire          Int?    @map("would_rehire")
  rating               Int?
  createdAt            String  @default("") @map("created_at")

  @@map("exit_interviews")
}
