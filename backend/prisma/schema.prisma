  employeeSeparationId   Int     @unique @map("employee_separation_id")
  unpaidSalaryDays       Float   @default(0) @map("unpaid_salary_days")
  unpaidSalaryAmount     Float   @default(0) @map("unpaid_salary_amount")
  noticeRecoveryDays     Float   @default(0) @map("notice_recovery_days")
  noticeRecoveryAmount   Float   @default(0) @map("notice_recovery_amount")
  leaveEncashmentDays    Float   @default(0) @map("leave_encashment_days")
  leaveEncashmentAmount  Float   @default(0) @map("leave_encashment_amount")
  bonusAmount            Float   @default(0) @map("bonus_amount")
